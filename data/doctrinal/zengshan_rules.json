        }
      ]
    },
    {
      "set_id": "ZS_SET_11",
      "set_name": "进神之法",
      "chapter": "进神退神章第二十九",
      "line": 2542,
      "polarity": "positive",
      "paired_with": "ZS_SET_12",
      "count_declared": 4,
      "count_actual": 4,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "动旺相而化旺相，乘势而进者，一也。",
          "rule_id": "R-ZS-11-01",
          "line": 2543
        },
        {
          "item_ordinal": 2,
          "definition_original": "动休囚而化休囚，待时而进者，二也。",
          "rule_id": "R-ZS-11-02",
          "line": 2544
        },
        {
          "item_ordinal": 3,
          "definition_original": "动爻变爻有一而值衰，待旺相之日而进者，三也。",
          "rule_id": "R-ZS-11-03",
          "line": 2545
        },
        {
          "item_ordinal": 4,
          "definition_original": "动爻变爻有一而值空破，待填实之日而进者，四也。",
          "rule_id": "R-ZS-11-04",
          "line": 2546
        }
      ]
    },
    {
      "set_id": "ZS_SET_12",
      "set_name": "退神之法",
      "chapter": "进神退神章第二十九",
      "line": 2547,
      "polarity": "negative",
      "paired_with": "ZS_SET_11",
      "count_declared": 4,
      "count_actual": 4,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "动旺相而化旺相，或有日月动爻生扶，占近事得时而不退者，一也。",
          "rule_id": "R-ZS-12-01",
          "line": 2548
        },
        {
          "item_ordinal": 2,
          "definition_original": "动休囚而化休囚，及时而退者，二也。",
          "rule_id": "R-ZS-12-02",
          "line": 2549
        },
        {
          "item_ordinal": 3,
          "definition_original": "动爻变爻有一而旺相，待休囚之时而退者，三也。",
          "rule_id": "R-ZS-12-03",
          "line": 2550
        },
        {
          "item_ordinal": 4,
          "definition_original": "动爻变爻有一逢空破，待填实之日而退者，四也。",
          "rule_id": "R-ZS-12-04",
          "line": 2551
        }
      ]
    },
    {
      "set_id": "ZS_SET_13",
      "set_name": "化生旺兮祸福",
      "chapter": "增删《黄金策千金赋》第三十四",
      "line": 3196,
      "polarity": "neutral",
      "paired_with": null,
      "count_declared": 3,
      "count_actual": 3,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "生者，动爻化长生也。如亥水动化出申金，既化长生又谓化回头之生；化酉金者，不曰化沐浴而曰化回头之生。此二者动爻有气化爻旺相，诸占皆吉。",
          "rule_id": "R-ZS-13-01",
          "line": 3197
        },
        {
          "item_ordinal": 2,
          "definition_original": "旺者，长生之第五位者是也。金木水火而化旺即是化进神，且如申金化酉金，亥水化子水，寅木化卯木，巳火化午火，诸占无不亨吉。",
          "rule_id": "R-ZS-13-02",
          "line": 3199
        },
        {
          "item_ordinal": 3,
          "definition_original": "惟土寄生于申，旺于子水为进神，辰未戌土动而化出子爻者，乃为化旺，丑土化出子爻者，即为化旺，又为化合，诸占皆吉。",
          "rule_id": "R-ZS-13-03",
          "line": 3201
        }
      ]
    },
    {
      "set_id": "ZS_SET_14",
      "set_name": "化官鬼兮吉凶",
      "chapter": "增删《黄金策千金赋》第三十四",
      "line": 3203,
      "polarity": "neutral",
      "paired_with": null,
      "count_declared": 2,
      "count_actual": 2,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "动爻变出官鬼，吉凶有二，何也？占功名者，世爻旺相或临日月或日月动爻生扶，动而变出官鬼者，乃是化官星，又无破损，乃为得官之兆也。",
          "rule_id": "R-ZS-14-01",
          "line": 3204
        },
        {
          "item_ordinal": 2,
          "definition_original": "世若休囚受克，动而变出官鬼星者，乃为变鬼，不惟难食禄于王家，须忧梦沉黄梁。",
          "rule_id": "R-ZS-14-02",
          "line": 3205
        }
      ]
    },
    {
