        },
        {
          "item_ordinal": 3,
          "definition_original": "爻与爻冲者，三也。",
          "rule_id": "R-ZS-07-03",
          "line": 1517
        },
        {
          "item_ordinal": 4,
          "definition_original": "卦逢六冲者，四也。",
          "rule_id": "R-ZS-07-04",
          "line": 1518
        },
        {
          "item_ordinal": 5,
          "definition_original": "六合卦变六冲卦者，五也。",
          "rule_id": "R-ZS-07-05",
          "line": 1519
        },
        {
          "item_ordinal": 6,
          "definition_original": "六冲卦变六冲卦者，六也。",
          "rule_id": "R-ZS-07-06",
          "line": 1520
        }
      ]
    },
    {
      "set_id": "ZS_SET_08",
      "set_name": "爻冲",
      "chapter": "六冲章第二十",
      "line": 1523,
      "polarity": "neutral",
      "paired_with": null,
