  "sets": [
    {
      "set_id": "ZS_SET_01",
      "set_name": "元神能生用神者",
      "chapter": "元神忌神衰旺章第十",
      "line": 906,
      "polarity": "positive",
      "paired_with": "ZS_SET_02",
      "count_declared": 5,
      "count_actual": 5,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "元神旺相，或临日月，或得日月动爻生扶者，一也。",
          "rule_id": "R-ZS-01-01",
          "line": 907
        },
        {
          "item_ordinal": 2,
          "definition_original": "元神长生、帝旺于日辰者，二也。",
          "rule_id": "R-ZS-01-02",
          "line": 908
        },
        {
          "item_ordinal": 3,
          "definition_original": "元神动化回头生及化进神者，三也。",
          "rule_id": "R-ZS-01-03",
          "line": 909
        },
        {
          "item_ordinal": 4,
          "definition_original": "元神与忌神同动者，四也。",
          "rule_id": "R-ZS-01-04",
          "line": 910
        },
        {
          "item_ordinal": 5,
          "definition_original": "元神旺动临空化空者，五也。",
          "rule_id": "R-ZS-01-05",
          "line": 911
        }
      ]
    },
    {
      "set_id": "ZS_SET_02",
      "set_name": "元神虽现又有不能生用神者",
      "chapter": "元神忌神衰旺章第十",
      "line": 925,
      "polarity": "negative",
      "paired_with": "ZS_SET_01",
      "count_declared": 6,
      "count_actual": 6,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "元神休囚不动，或动而休囚又被伤克者一也。",
          "rule_id": "R-ZS-02-01",
          "line": 926
        },
        {
          "item_ordinal": 2,
          "definition_original": "元神休囚又逢旬空、月破二也。",
          "rule_id": "R-ZS-02-02",
          "line": 927
        },
        {
          "item_ordinal": 3,
          "definition_original": "元神休囚动化退神三也。",
          "rule_id": "R-ZS-02-03",
          "line": 928
        },
        {
          "item_ordinal": 4,
          "definition_original": "元神衰而又绝四也。",
          "rule_id": "R-ZS-02-04",
          "line": 929
        },
        {
          "item_ordinal": 5,
          "definition_original": "元神入三墓五也。",
          "rule_id": "R-ZS-02-05",
          "line": 930
        },
        {
          "item_ordinal": 6,
          "definition_original": "元神休囚动而化绝、化克、化破、化散六也。",
          "rule_id": "R-ZS-02-06",
          "line": 931
        }
      ]
    },
    {
      "set_id": "ZS_SET_03",
