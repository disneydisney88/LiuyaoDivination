    },
    {
      "set_id": "ZS_SET_05",
      "set_name": "成三合局者",
      "chapter": "三合局相關段落",
      "line": 1444,
      "polarity": "neutral",
      "paired_with": null,
      "count_declared": 4,
      "count_actual": 4,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "一卦之内有三爻动而合局者一也。",
          "rule_id": "R-ZS-05-01",
          "line": 1445
        },
        {
          "item_ordinal": 2,
          "definition_original": "若两爻动一爻不动亦成合局者二也。",
          "rule_id": "R-ZS-05-02",
          "line": 1446
        },
        {
          "item_ordinal": 3,
          "definition_original": "有内卦初爻、三爻动与变爻合局者三也。",
          "rule_id": "R-ZS-05-03",
          "line": 1447
        },
        {
          "item_ordinal": 4,
          "definition_original": "有外卦四爻、六爻动与变爻合局者四也。",
          "rule_id": "R-ZS-05-04",
          "line": 1448
        }
      ]
    },
    {
      "set_id": "ZS_SET_06",
      "set_name": "相合之法",
      "chapter": "六合章第十九",
      "line": 1342,
      "polarity": "neutral",
      "paired_with": null,
      "count_declared": 6,
      "count_actual": 6,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "日月合爻者一也。如丑月占得坎卦，世爻子水与月建作合是也。",
          "rule_id": "R-ZS-06-01",
          "line": 1343
        },
        {
          "item_ordinal": 2,
          "definition_original": "爻与爻合者二也。如占得天地否卦，世应俱动，卯与戌合是也。但有一爻不动，亦不为合。",
          "rule_id": "R-ZS-06-02",
          "line": 1344
        },
        {
          "item_ordinal": 3,
          "definition_original": "爻动化合者三也。如占得天风姤卦，世爻丑动，化出子水作合是也。",
          "rule_id": "R-ZS-06-03",
          "line": 1345
        },
        {
          "item_ordinal": 4,
          "definition_original": "卦逢六合者四也。如占得天地否卦，内外六爻自相和合者是也，不动亦是。",
          "rule_id": "R-ZS-06-04",
          "line": 1346
        },
        {
          "item_ordinal": 5,
          "definition_original": "六冲卦变六合者五也。如占得乾为天卦，乃八纯六冲之卦，若外卦三爻俱动，变为地天泰卦，谓之六冲而变六合是也。",
          "rule_id": "R-ZS-06-05",
          "line": 1347
        },
        {
          "item_ordinal": 6,
          "definition_original": "六合卦变六合者六也。如占得旅卦变贲卦是也。",
          "rule_id": "R-ZS-06-06",
          "line": 1349
        }
      ]
    },
    {
      "set_id": "ZS_SET_07",
      "set_name": "相冲之法",
      "chapter": "六冲章第二十",
      "line": 1514,
      "polarity": "neutral",
      "paired_with": null,
      "count_declared": 6,
      "count_actual": 6,
      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
