      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "伏神休囚无气者一也；",
          "rule_id": "R-ZS-10-01",
          "line": 2182
        },
        {
          "item_ordinal": 2,
          "definition_original": "伏神被日月动爻冲克者二也；",
          "rule_id": "R-ZS-10-02",
