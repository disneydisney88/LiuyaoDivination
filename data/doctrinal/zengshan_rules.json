      "count_mismatch": false,
      "attribution": "own_claim",
      "items": [
        {
          "item_ordinal": 1,
          "definition_original": "忌神休囚不动，或动而休囚又被日月动爻克者一也。",
          "rule_id": "R-ZS-04-01",
