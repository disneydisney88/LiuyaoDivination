          "rule_id": "R-ZS-04-02",
          "line": 945
        },
        {
          "item_ordinal": 3,
          "definition_original": "忌神入三墓三也。",
          "rule_id": "R-ZS-04-03",
          "line": 946
        },
        {
          "item_ordinal": 4,
          "definition_original": "忌神动化退神四也。",
          "rule_id": "R-ZS-04-04",
